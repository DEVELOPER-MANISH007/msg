# Worker secrets are configured with Wrangler secrets for deployment.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PLACEHOLDER_ONLY

# Public Android Worker endpoint: pass to Gradle as -PchatApiBase=https://<worker>.workers.dev
# This endpoint is not a secret. Do not add database credentials to Android configuration.
API_BASE=https://YOUR_WORKER.workers.dev
